--- before/c\Function\Function.c
+++ c\Function\Function.c
@@ -1,4 +1,79 @@
 #include "h\Allinclude.h"
+
+// 电解：每次开机一轮；异常结束本轮，重新开机才允许再次运行。
+#define C_DJ_MINUTE_TICKS       6000U  // 60秒 / 10ms
+#define C_DJ_TOTAL_MINUTES      30U
+#define C_DJ_IDLE              0
+#define C_DJ_WAIT              1
+#define C_DJ_RUN               2
+
+void F_mElectrolysisControl(void)
+{
+    static U8 xdata s_u8PowerBak = 0;
+    static U8 xdata s_u8State = C_DJ_IDLE;
+    static U8 xdata s_u8Minutes = 0;
+    static U16 xdata s_u16MinuteTicks = 0;
+
+    if(s_u8PowerBak != g_stSys.bTurnOn)
+    {
+        s_u8PowerBak = g_stSys.bTurnOn;
+        s_u8State = g_stSys.bTurnOn ? C_DJ_WAIT : C_DJ_IDLE;
+        s_u8Minutes = 0;
+        s_u16MinuteTicks = 0;
+        P_DJ1 = 0;
+        P_DJ2 = 0;
+    }
+
+    // 每圈检查关机、自检和运行异常，不等待计时节拍。
+    if(!g_stSys.bTurnOn || g_u8TestState)
+        s_u8State = C_DJ_IDLE;
+    if(s_u8State == C_DJ_RUN &&
+       (g_stSys.bWaterLack || g_stSys.bTankRemoved || g_stSys.bIsAirDrying))
+        s_u8State = C_DJ_IDLE;
+
+    if(s_u8State == C_DJ_IDLE)
+    {
+        P_DJ1 = 0;
+        P_DJ2 = 0;
+        return;
+    }
+    if(!F_GetTimeTick(C_TIME_10ms)) return;
+
+    if(s_u8State == C_DJ_WAIT)
+    {
+        // 上电默认标志不等于已确认有水，必须完成水位检测。
+        if(!g_bElectrolysisWaterReady || g_stSys.bWaterLack ||
+           g_stSys.bTankRemoved || g_stSys.bIsAirDrying) return;
+        s_u8State = C_DJ_RUN;
+        P_DJ1 = 1;
+        P_DJ2 = 0;
+        return; // 从真正输出后的下一个节拍开始累计
+    }
+
+    if(++s_u16MinuteTicks >= C_DJ_MINUTE_TICKS)
+    {
+        s_u16MinuteTicks = 0;
+        P_DJ1 = 0;
+        P_DJ2 = 0;
+        if(++s_u8Minutes >= C_DJ_TOTAL_MINUTES)
+            s_u8State = C_DJ_IDLE;
+        return; // 换向前保持00一个10ms节拍，间隔计入30分钟总时长
+    }
+    if(s_u16MinuteTicks == 1)
+    {
+        if(s_u8Minutes & 1)
+        {
+            P_DJ1 = 0;
+            P_DJ2 = 1;
+        }
+        else
+        {
+            P_DJ2 = 0;
+            P_DJ1 = 1;
+        }
+    }
+}
+
 
